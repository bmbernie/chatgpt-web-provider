# Optional TOML configuration file. Environment variables override it.
# CHATGPT_WEB_CONFIG=~/.config/chatgpt-web-provider/config.toml

CHATGPT_WEB_API_KEYS=replace-with-a-long-random-token
CHATGPT_WEB_BACKEND=mock
CHATGPT_WEB_MODEL=chatgpt-5.6-sol-web
CHATGPT_WEB_MODELS=chatgpt-5.6-sol-web,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4,gpt-5.4-mini,gpt-5.3,gpt-5.3-codex-spark,o3
CHATGPT_WEB_MODEL_LABELS="chatgpt-5.6-sol-web=GPT-5.6 Sol,gpt-5.6-terra=5.6 Terra,gpt-5.6-luna=5.6 Luna,gpt-5.5=GPT-5.5,gpt-5.4=GPT-5.4,gpt-5.4-mini=5.4 Mini,gpt-5.3=GPT-5.3,gpt-5.3-codex-spark=5.3 Codex Spark,o3=o3"
CHATGPT_WEB_LEVELS=auto,fast,standard,high
CHATGPT_WEB_LEVEL_LABELS="auto=Auto,fast=Fast,standard=Standard,high=High"
CHATGPT_WEB_HOST=127.0.0.1
CHATGPT_WEB_PORT=8791
CHATGPT_WEB_PUBLIC_BASE_URL=https://codex.example.com
CHATGPT_WEB_PROFILE_DIR=/home/example/.local/share/chatgpt-web-provider/chrome-profile
CHATGPT_WEB_HEADLESS=true
CHATGPT_WEB_REQUEST_TIMEOUT_SECONDS=300
CHATGPT_WEB_MAX_CONCURRENT_REQUESTS=1
CHATGPT_WEB_QUEUE_TIMEOUT_SECONDS=600

# Optional operator-defined advisory Retry-After value for a detected
# ChatGPT UI rate-limit state. Leave unset when the actual reset time
# is unknown.
# CHATGPT_WEB_UI_RATE_LIMIT_RETRY_AFTER_SECONDS=300

# Optional transport overrides.
CHATGPT_WEB_INLINE_FILL_MAX_CHARS=16384
CHATGPT_WEB_CLIPBOARD_CHUNK_SIZE=4096

# Optional browser/UI overrides.
CHATGPT_WEB_CHATGPT_BASE_URL=https://chatgpt.com/
CHATGPT_WEB_VIEWPORT_WIDTH=1360
CHATGPT_WEB_VIEWPORT_HEIGHT=820
CHATGPT_WEB_NAVIGATION_TIMEOUT_MS=60000
CHATGPT_WEB_COMPOSER_READY_TIMEOUT_MS=30000

# Optional policy/generation timing overrides.
CHATGPT_WEB_POLICY_LAUNCH_TIMEOUT_MS=30000
CHATGPT_WEB_POLICY_READY_TIMEOUT_MS=10000
CHATGPT_WEB_REASONING_CONTROL_TIMEOUT_MS=45000
CHATGPT_WEB_GENERATION_TIMEOUT_SECONDS=240
CHATGPT_WEB_GENERATION_POLL_MS=1000
CHATGPT_WEB_GENERATION_SETTLE_MS=1500
CHATGPT_WEB_NEW_SESSION_SETTLE_MS=1500

# Optional picker/action/submit timing overrides.
CHATGPT_WEB_PICKER_READY_TIMEOUT_MS=5000
CHATGPT_WEB_PICKER_TRANSITION_TIMEOUT_MS=5000
CHATGPT_WEB_UI_ACTION_TIMEOUT_MS=3000
CHATGPT_WEB_SUBMIT_READY_TIMEOUT_MS=30000
CHATGPT_WEB_SUBMIT_CONFIRM_TIMEOUT_MS=5000

# Optional response-extraction timeout override.
CHATGPT_WEB_EXTRACTION_TIMEOUT_MS=5000
